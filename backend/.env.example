# Copie ce fichier en ".env" puis remplis les vraies valeurs.
# Le fichier ".env" est ignoré par Git (voir .gitignore).

# Port sur lequel le backend écoute
PORT=3000

# "development" en local, "production" une fois en ligne
NODE_ENV=development

# Adresse du frontend (sert à autoriser les requêtes CORS)
FRONTEND_URL=http://localhost:5173

# Lien de connexion PostgreSQL fourni par Supabase :
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres

# Clé secrète pour signer les JWT : longue, aléatoire, jamais partagée
# Génère-en une avec : openssl rand -base64 48
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-48-caracteres-minimum

# Durée de validité d'une connexion (en secondes) : 604800 = 7 jours
JWT_EXPIRES_IN=604800
